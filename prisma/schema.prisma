generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                 String    @id @default(cuid())
  companyName        String
  companyTagline     String?
  companyAddress     String?
  companyPhone       String?
  companyEmail       String?
  npwp               String?
  logoUrl            String?
  bankName           String?
  bankAccount        String?
  bankHolder         String?
  bankSwift          String?
  signerName         String?
  signerTitle        String?
  plan               Plan      @default(TRIAL)
  modulesEnabled     String[]
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  defaultAgencyPct   Float     @default(2.5)
  defaultCurrency    String    @default("IDR")
  docLanguage        String    @default("EN")
  defaultDAFormat    String    @default("FPDA")

  /// Fase 6a / K55 — kapan tenant ini mulai memakai aplikasi untuk pekerjaan
  /// SUNGGUHAN. `null` = belum go-live, sehingga setiap baris baru dicap 'UJI'
  /// (K56). Ditekan ADMIN lewat Settings › Data & AI. Mengubahnya TIDAK pernah
  /// mengubah asal baris yang SUDAH ada — asal adalah snapshot, bukan turunan.
  goLiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  vessels    Vessel[]
  principals Principal[]
  portCalls  PortCall[]
  documents  MaritimeDocument[]
  payments   Payment[]

  // --- v2 (voyage-centric). Lihat docs/FASE-0-SKEMA-v2.md ---
  ports            Port[]
  customers        Customer[]
  vendors          Vendor[]
  currencies       Currency[]
  exchangeRates    ExchangeRate[]
  services         ServiceCatalog[]
  serviceRates     ServiceRate[]
  serviceTemplates ServiceTemplate[]
  voyages          Voyage[]
  disbursements    Disbursement[]
  invoices         Invoice[]
  invoicePayments  InvoicePayment[]
  approvals        Approval[]
  auditLogs        AuditLog[]
  notifications    Notification[]

  // --- Fase 7 (operations & collaboration). Lihat docs/FASE-7-OPERATIONS.md ---
  tasks             Task[]
  taskTemplates     TaskTemplate[]
  attachments       Attachment[]
  comments          Comment[]
  vendorRatings     VendorRating[]
  purchaseOrders    PurchaseOrder[]
  workOrders        WorkOrder[]
  crewChanges       CrewChange[]
  voyageEvents      VoyageEvent[]
  emailLogs         EmailLog[]
  portPlaybooks     PortPlaybook[]
  knowledgeArticles KnowledgeArticle[]
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId    String // 'm1' | 'm2' | 'all' (lihat lib/billing/plans.ts)
  plan      Plan // enum hasil pemetaan planId
  amount    Int // IDR, tanpa desimal — sama dengan gross_amount ke Midtrans
  modules   String[] // modul yang dipilih untuk paket ini
  status    PaymentStatus @default(PENDING)
  snapToken String?
  paidAt    DateTime?
  raw       Json? // payload notifikasi terakhir dari Midtrans (audit)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tenantId])
  @@index([status])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(OPERATOR)
  /// Fase 5g — nonaktif via UI Tim, BUKAN dihapus keras: AuditLog.userId (string
  /// polos, tanpa relasi FK) akan kehilangan makna kalau baris User-nya lenyap.
  isActive  Boolean  @default(true)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vessel {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  imoNumber  String?
  flag       String?
  callSign   String?
  vesselType String?
  gt         Float?
  nrt        Float?
  loa        Float?
  beam       Float?
  maxDraft   Float?
  yearBuilt  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  portCalls PortCall[]
  documents MaritimeDocument[]
  voyages   Voyage[]

  @@index([tenantId])
}

model Principal {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  address         String?
  npwp            String?
  email           String?
  phone           String?
  contactPerson   String?
  preferredFormat String   @default("FPDA")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  portCalls PortCall[]
  documents MaritimeDocument[]
  voyages   Voyage[]

  @@index([tenantId])
}

model PortCall {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vesselId    String
  vessel      Vessel     @relation(fields: [vesselId], references: [id])
  principalId String?
  principal   Principal? @relation(fields: [principalId], references: [id])
  port        String
  portCode    String?

  // --- v2: opsional dulu agar data lama tetap sah; diisi lewat skrip backfill (M3) ---
  voyageId  String?
  voyage    Voyage?        @relation(fields: [voyageId], references: [id])
  portRefId String?
  portRef   Port?          @relation(fields: [portRefId], references: [id])
  eta       DateTime?
  etd       DateTime?
  ata       DateTime?
  atd       DateTime?
  cargo     String?
  cargoQty  String?
  cargoUnit String?
  status    PortCallStatus @default(UPCOMING)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  documents MaritimeDocument[]

  // --- Fase 7 ---
  tasks        Task[]
  voyageEvents VoyageEvent[]

  @@index([tenantId])
  @@index([status])
}

model MaritimeDocument {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vesselId     String?
  vessel       Vessel?    @relation(fields: [vesselId], references: [id])
  principalId  String?
  principal    Principal? @relation(fields: [principalId], references: [id])
  portCallId   String?
  portCall     PortCall?  @relation(fields: [portCallId], references: [id])
  // v2: tautan ke Voyage (opsional; diisi backfill M4 lewat portCallId).
  voyageId     String?
  voyage       Voyage?    @relation(fields: [voyageId], references: [id])
  docType      DocType
  docNumber    String
  port         String?
  currency     String     @default("IDR")
  exchangeRate Float?
  lineItems    Json?
  subtotals    Json?
  grandTotal   Float?
  agencyPct    Float      @default(2.5)
  agencyAmt    Float?
  status       DocStatus  @default(DRAFT)
  notes        String?
  issuedAt     DateTime   @default(now())
  validUntil   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tenantId])
  @@index([docType])
  @@index([status])
}

/// Fase 5e (12 Ags 2026) — 4→7, dirumuskan dari §7.2 Blueprint 2.0 Vol 1
/// (docs/blueprint-src/content.js) + keputusan user hari ini:
/// - MANAJER_OPERASI: bisa approve EPDA/FDA (approval-policy.ts), TIDAK bisa ubah Master Data/Settings.
/// - PENYUSUN_BIAYA: hanya EPDA/FDA (susun/ubah/ajukan review), TIDAK boleh Voyage/Port Call/Master Data.
/// - DIREKTUR: lihat-saja semua (Dashboard/Reports/Audit), tak pernah muncul di requireRole() manapun.
enum Role {
  ADMIN
  OPERATOR
  FINANCE
  VIEWER
  MANAJER_OPERASI
  PENYUSUN_BIAYA
  DIREKTUR
}

enum Plan {
  TRIAL
  STARTER
  PRO
  FULL_SUITE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PortCallStatus {
  UPCOMING
  IN_PORT
  DEPARTED
  CANCELLED
}

enum DocType {
  FAL_BUNDLE
  FAL_1
  FAL_2
  FAL_3
  FAL_4
  FAL_5
  FAL_6
  FAL_7
  NOR
  SOF
  ARRIVAL_REPORT
  DEPARTURE_REPORT
  DAMAGE_REPORT
  ULLAGE_REPORT
  PORT_CALL_SUMMARY
  TIME_SHEET
  SIB
  AGENCY_APPOINTMENT
  SPK
  LETTER_OF_PROTEST
  NOTE_OF_PROTEST
  LETTER_OF_INDEMNITY
  CREW_CHANGE_NOTICE
  CREW_SIGN_ON
  CREW_SIGN_OFF
  SHORE_PASS
  MARITIME_DECLARATION_OF_HEALTH
  NOTICE_OF_ARRIVAL
  CASH_TO_MASTER
  LETTER_OF_AUTHORIZATION
  EPDA
  FPDA
  FOA
  INVOICE
  PURCHASE_REQUISITION
  PURCHASE_ORDER
  BUNKER_REQUISITION
  BDN
  DEBIT_NOTE
  CREDIT_NOTE
  OFFICIAL_RECEIPT
  STATEMENT_OF_ACCOUNT
  BILL_OF_LADING
}

enum DocStatus {
  DRAFT
  FINAL
  SENT
  PAID
  CANCELLED
}

// ============================================================================
// v2 — VOYAGE-CENTRIC. Rancangan & alasan: docs/FASE-0-SKEMA-v2.md
//
// Tambahan bersifat ADITIF: tak ada tabel/kolom lama yang dihapus, sehingga
// app yang sedang dipakai tetap jalan. Cut-over dilakukan per modul.
//
// Prinsip snapshot (K5): baris Disbursement MENYALIN tarif & cara hitung saat
// dibuat. Kalau menunjuk tarif hidup, menaikkan tarif hari ini akan mengubah
// nilai EPDA tahun lalu — fatal untuk audit & sengketa dengan principal.
// ============================================================================

// ---------------------------------------------------------------- MASTER DATA

model Port {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  unlocode      String? // IDSMR, IDBPN, SGSIN
  country       String?
  timezone      String?
  latitude      Float?
  longitude     Float?
  portAuthority String?
  pilotRequired Boolean   @default(false)
  tugRequired   Boolean   @default(false)
  maxDraft      Float?
  maxLoa        Float?
  workingHours  String?
  notes         String? // cikal bakal Port Playbook (Fase 7)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // soft delete (PRD §40)

  portCalls        PortCall[]
  voyages          Voyage[]
  serviceRates     ServiceRate[]
  serviceTemplates ServiceTemplate[]

  // --- Fase 7 ---
  taskTemplates TaskTemplate[]
  crewChanges   CrewChange[]
  playbooks     PortPlaybook[]

  @@unique([tenantId, unlocode])
  @@index([tenantId])
}

/// Pihak yang DITAGIH. Berbeda peran dari Principal (pemberi order / owner).
model Customer {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  customerType    String?
  address         String?
  npwp            String?
  email           String?
  phone           String?
  contactPerson   String?
  currency        String    @default("IDR")
  creditLimit     Float?
  paymentTermDays Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  voyages  Voyage[]
  invoices Invoice[]

  @@index([tenantId])
}

model Vendor {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  vendorType      String? // PILOT, TUG, FRESH_WATER, GARBAGE, ...
  address         String?
  npwp            String?
  email           String?
  phone           String?
  contactPerson   String?
  bankName        String?
  bankAccount     String?
  paymentTermDays Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  services          ServiceCatalog[]
  disbursementItems DisbursementItem[]

  // --- Fase 7 ---
  tasks          Task[]
  ratings        VendorRating[]
  purchaseOrders PurchaseOrder[]
  workOrders     WorkOrder[]

  @@index([tenantId])
}

model Currency {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code     String // IDR, USD, SGD
  name     String?
  symbol   String?
  decimals Int     @default(2)
  isActive Boolean @default(true)

  @@unique([tenantId, code])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCurrency  String
  toCurrency    String
  rate          Float
  effectiveDate DateTime
  source        String? // MANUAL | BI | ECB
  createdAt     DateTime @default(now())

  @@index([tenantId, fromCurrency, toCurrency, effectiveDate])
}

// ------------------------------------------------------------ SERVICE CATALOG

/// Cara sebuah biaya dihitung. Sengaja enum, bukan rumus teks yang di-eval —
/// rumus teks = lubang keamanan. Enum menutup ~95% kasus nyata; sisanya MANUAL.
enum CalcMethod {
  FLAT // lump sum
  PER_UNIT // qty × rate
  PER_GT // GT kapal × rate
  PER_GT_PER_CALL
  PER_GT_PER_DAY
  PER_DAY
  PER_HOUR
  PER_TON // tonase kargo × rate
  PERCENTAGE // % dari basis (mis. agency fee)
  TIERED // berjenjang menurut GT (lihat ServiceRate.gtMin/gtMax)
  MANUAL // diketik operator
}

enum ServiceCategory {
  PORT_CHARGES // light dues, port dues, wharfage, anchorage
  MARINE_SERVICES // pilot, tug, mooring, launch boat
  GOVERNMENT // customs, immigration, quarantine, harbour master
  HUSBANDRY // crew change, fresh water, garbage, CTM, medical
  AGENCY // agency fee, communication, documentation
  OTHER // miscellaneous, contingency
}

/// Definisi jasa + CARA menghitungnya. Tarifnya sendiri ada di ServiceRate,
/// karena tarif berbeda tiap pelabuhan dan berubah seiring waktu.
model ServiceCatalog {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceCode     String // PILOT, TUG, LIGHT_DUES
  serviceName     String
  category        ServiceCategory
  calcMethod      CalcMethod      @default(MANUAL)
  defaultUnit     String? // call, hour, ton, day, GT
  defaultCurrency String          @default("IDR")
  taxable         Boolean         @default(false)
  taxPct          Float?
  defaultVendorId String?
  defaultVendor   Vendor?         @relation(fields: [defaultVendorId], references: [id])
  glAccount       String?
  usedInEstimate  Boolean         @default(true) // muncul di EPDA
  usedInActual    Boolean         @default(true) // muncul di FDA
  sectionLetter   String? // A/B/C/D — menjaga tata letak PDF app A
  displayOrder    Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  rates             ServiceRate[]
  templateItems     ServiceTemplateItem[]
  disbursementItems DisbursementItem[]

  // --- Fase 7 ---
  workOrders WorkOrder[]

  @@unique([tenantId, serviceCode])
  @@index([tenantId, category])
}

/// Tarif satu jasa pada satu pelabuhan untuk satu rentang waktu.
/// portId null = tarif umum. gtMin/gtMax dipakai bila calcMethod = TIERED.
model ServiceRate {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId     String
  service       ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  portId        String?
  port          Port?          @relation(fields: [portId], references: [id])
  vesselType    String?
  gtMin         Float?
  gtMax         Float?
  rate          Float
  currency      String         @default("IDR")
  minCharge     Float?
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, serviceId, portId, effectiveFrom])
}

/// Paket biaya standar per pelabuhan (PRD §92) — sekali pilih, semua item termuat.
model ServiceTemplate {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  portId     String?
  port       Port?    @relation(fields: [portId], references: [id])
  vesselType String?
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items ServiceTemplateItem[]

  @@index([tenantId, portId])
}

model ServiceTemplateItem {
  id           String          @id @default(cuid())
  templateId   String
  template     ServiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  serviceId    String
  service      ServiceCatalog  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  defaultQty   Float?
  displayOrder Int             @default(0)

  @@index([templateId])
}

// ------------------------------------------------------------------- OPERATION

enum VoyageStatus {
  PLANNED
  CONFIRMED
  ARRIVED
  BERTHED
  WORKING
  COMPLETED
  DEPARTED
  CLOSED
  CANCELLED
}

/// Hub seluruh sistem: satu voyage = satu "folder digital" berisi port call,
/// kargo, EPDA/FDA, invoice, dan dokumen terkait.
model Voyage {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voyageNumber String // VYG-2026-000001
  vesselId     String
  vessel       Vessel       @relation(fields: [vesselId], references: [id])
  principalId  String? // pemberi order / owner
  principal    Principal?   @relation(fields: [principalId], references: [id])
  customerId   String? // pihak ditagih
  customer     Customer?    @relation(fields: [customerId], references: [id])
  portId       String?
  port         Port?        @relation(fields: [portId], references: [id])
  agencyType   String? // FULL, PROTECTIVE, HUSBANDRY
  status       VoyageStatus @default(PLANNED)

  eta DateTime?
  etb DateTime?
  etc DateTime?
  etd DateTime?
  ata DateTime?
  atb DateTime?
  atd DateTime?

  baseCurrency String  @default("IDR")
  notes        String?

  /// Fase 6a / K55 — 'SEED' | 'UJI' | 'NYATA'. Dicap SAAT BARIS DIBUAT (K56),
  /// bukan disimpulkan saat query. Sengaja `String?` dan bukan enum Prisma:
  /// nilai keempat ('MIGRASI') tidak akan butuh migration lagi, dan modul murni
  /// Fase 6 cukup memakai konstanta `ASAL_DATA` di services/ai/provenance.ts.
  /// `null` ditafsirkan 'UJI' — BUKAN NYATA (K57).
  dataOrigin String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  portCalls     PortCall[]
  cargoes       Cargo[]
  disbursements Disbursement[]
  invoices      Invoice[]
  documents     MaritimeDocument[]

  // --- Fase 7 ---
  tasks          Task[]
  purchaseOrders PurchaseOrder[]
  workOrders     WorkOrder[]
  crewChanges    CrewChange[]
  events         VoyageEvent[]

  @@unique([tenantId, voyageNumber])
  @@index([tenantId, status])
  @@index([tenantId, eta])
  @@index([tenantId, vesselId])
}

model Cargo {
  id        String   @id @default(cuid())
  voyageId  String
  voyage    Voyage   @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  cargoName String
  quantity  Float?
  unit      String? // MT, m3, TEU
  operation String? // LOAD | DISCHARGE
  shipper   String?
  consignee String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([voyageId])
}

// ----------------------------------------------------------------- DISBURSEMENT

enum DisbursementKind {
  EPDA
  FPDA
  FDA
}

enum DisbursementStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SENT
  REVISION_REQUESTED
  REVISED
  FINAL
  CLOSED
  CANCELLED
}

/// EPDA/FPDA/FDA disatukan (app A pun sudah menyatukan handler PDF-nya).
/// Variance = bandingkan baris FDA dengan baris EPDA lewat sourceItemId.
model Disbursement {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voyageId  String
  voyage    Voyage           @relation(fields: [voyageId], references: [id])
  kind      DisbursementKind
  docNumber String // EPDA/2026/06/0142 — pola app A dipertahankan

  // --- versioning (PRD §97-98). Revisi = baris BARU dengan rootId sama. ---
  rootId       String? // penanda rumpun revisi; V1 = id dirinya sendiri
  version      Int     @default(1)
  supersededBy String? // diisi saat versi penerus dibuat
  revisionNote String?

  baseCurrency    String @default("IDR")
  subtotal        Float  @default(0)
  agencyPct       Float  @default(2.5)
  agencyAmount    Float  @default(0)
  taxAmount       Float  @default(0)
  grandTotal      Float  @default(0)
  advanceReceived Float?

  status     DisbursementStatus @default(DRAFT)
  issuedAt   DateTime           @default(now())
  validUntil DateTime?
  notes      String?

  /// Fase 6a / K55 — 'SEED' | 'UJI' | 'NYATA'. Unit grounding prediksi Fase 6:
  /// item FDA dibaca lewat induk ini, jadi asalnya melekat di sini. Asal EFEKTIF
  /// = yang paling pesimis antara voyage & dokumen ini (K58, asalEfektif()).
  dataOrigin String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items    DisbursementItem[]
  invoices Invoice[]

  // --- Fase 7 ---
  tasks Task[]

  @@unique([tenantId, docNumber])
  @@index([tenantId, voyageId, kind])
  @@index([tenantId, status])
  @@index([rootId])
}

/// Satu baris biaya. Angka di sini SUDAH BISA DIHITUNG — pengganti `qty` teks
/// bebas ("8,432 GT") di EpdaLineItem lama yang mustahil dihitung mesin.
model DisbursementItem {
  id             String          @id @default(cuid())
  disbursementId String
  disbursement   Disbursement    @relation(fields: [disbursementId], references: [id], onDelete: Cascade)
  serviceId      String? // null = item ad-hoc di luar katalog
  service        ServiceCatalog? @relation(fields: [serviceId], references: [id])
  vendorId       String?
  vendor         Vendor?         @relation(fields: [vendorId], references: [id])

  category      ServiceCategory?
  sectionLetter String? // A/B/C/D untuk tata letak PDF
  description   String
  basis         String? // teks tampil, mis. "per GT per call"

  quantity   Float      @default(1)
  unit       String?
  unitPrice  Float      @default(0)
  minCharge  Float? // snapshot ServiceRate.minCharge (K15) — tanpa ini invarian K13 patah
  calcMethod CalcMethod @default(MANUAL) // snapshot (K5)

  currency     String  @default("IDR")
  exchangeRate Float   @default(1) // snapshot (K5)
  amount       Float   @default(0) // dalam currency item
  amountBase   Float   @default(0) // dikonversi ke baseCurrency induk
  taxable      Boolean @default(false)
  // Snapshot ServiceCatalog.taxPct (K22). Kolomnya tak ada di Fase 0 walau K22
  // mewajibkan snapshot-nya; tanpa kolom ini taxAmount hanya bisa dihitung ulang
  // dengan membaca katalog hidup — melanggar K5 (menaikkan PPN hari ini akan
  // mengubah dokumen lama). Aditif & nullable, sebentuk dengan minCharge.
  taxPct       Float?
  taxAmount    Float?

  // --- khusus FDA ---
  // K40 (Fase 3): diperluas resmi jadi "baris asal tempat baris ini disalin" —
  // dipakai DUA hal: item versi baru → item versi lama (diff revisi, K39) DAN
  // item FDA → item EPDA (variance, K46). Keduanya tak pernah bertabrakan pada
  // satu baris (satu baris punya paling banyak satu pendahulu langsung).
  sourceItemId     String? // baris asal tempat baris ini disalin → diff revisi / variance
  vendorInvoiceNo  String?
  actualReceiptRef String?

  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([disbursementId])
  @@index([serviceId])
  @@index([sourceItemId])
}

// ---------------------------------------------------------------- FINANCE (AR)

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id                   String        @id @default(cuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voyageId             String?
  voyage               Voyage?       @relation(fields: [voyageId], references: [id])
  sourceDisbursementId String? // dibuat dari FDA (PRD §105)
  sourceDisbursement   Disbursement? @relation(fields: [sourceDisbursementId], references: [id])
  invoiceNumber        String
  customerId           String?
  customer             Customer?     @relation(fields: [customerId], references: [id])

  invoiceDate DateTime      @default(now())
  dueDate     DateTime?
  currency    String        @default("IDR")
  subtotal    Float         @default(0)
  taxAmount   Float         @default(0)
  grandTotal  Float         @default(0)
  amountPaid  Float         @default(0)
  status      InvoiceStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  items    InvoiceItem[]
  payments InvoicePayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description  String
  quantity     Float    @default(1)
  unit         String?
  unitPrice    Float    @default(0)
  amount       Float    @default(0)
  taxable      Boolean  @default(false)
  taxAmount    Float?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([invoiceId])
}

/// Pembayaran tagihan PELANGGAN (AR). Sengaja bukan `Payment` — model itu
/// sudah dipakai untuk langganan SaaS lewat Midtrans, urusan yang berbeda.
model InvoicePayment {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentDate     DateTime @default(now())
  amount          Float
  currency        String   @default("IDR")
  exchangeRate    Float    @default(1)
  bankName        String?
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, invoiceId])
}

// -------------------------------------------------------------- AUDIT & CONTROL

/// Jejak persetujuan. Sekali tersimpan tidak boleh diubah (PRD §114).
model Approval {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // DISBURSEMENT | INVOICE | PO
  entityId   String
  level      Int      @default(1)
  userId     String
  userName   String? // disalin agar tetap terbaca bila user dihapus
  userRole   String?
  decision   String // APPROVED | REJECTED | REQUEST_REVISION
  note       String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tableName String
  recordId  String
  action    String // CREATE | UPDATE | DELETE | APPROVE | EXPORT | LOGIN
  oldValue  Json?
  newValue  Json?
  userId    String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId, tableName, recordId])
  @@index([tenantId, createdAt])
}

/// Notification Center (Fase 5d). `userId = null` = siaran ke semua pengguna
/// tenant (skala tim kecil ship agency — bukan diperuntukkan tenant besar
/// berpuluh pengguna). K-serupa: `readAt` SATU nilai per baris, bukan per
/// pengguna — siapa pun yang membaca duluan menandainya terbaca untuk semua.
/// Ini simplifikasi sadar untuk v1 (hindari tabel gabung NotificationRead);
/// perlu ditinjau ulang bila tenant besar mulai memakai modul ini.
model Notification {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String? // null = siaran ke semua pengguna tenant
  type       String // APPROVAL_PENDING | INVOICE_OVERDUE | INVOICE_PAID
  title      String
  message    String?
  entityType String? // DISBURSEMENT | INVOICE | TASK | PURCHASE_ORDER | WORK_ORDER | VENDOR | CREW_CHANGE
  entityId   String?
  href       String?
  readAt     DateTime?

  /// Fase 7 / K86 + K101 — kunci idempotensi untuk pengingat & SLA yang ditulis
  /// job tanpa manusia: sapuan yang sama dijalankan 1× atau 50× sehari harus
  /// menghasilkan baris yang sama persis. `null` untuk notifikasi yang dipicu
  /// peristiwa (approval/invoice) — dan `@@unique` di bawah aman justru karena
  /// Postgres tidak pernah menganggap dua `NULL` bertabrakan (K89).
  dedupeKey String?

  createdAt DateTime @default(now())

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, readAt, createdAt])
}

// ============================================================================
// FASE 7 — OPERATIONS & COLLABORATION
// Rujukan: docs/FASE-7-OPERATIONS.md. Seluruh penambahan di bawah ADITIF (K89):
// tidak ada kolom lama yang berubah tipe, nullability, atau dihapus.
//
// Dua belas model bertenant di bawah WAJIB terdaftar di TENANT_MODELS
// (src/services/tenant-guard.ts). Empat model ANAK — TaskTemplateItem,
// PurchaseOrderItem, CrewChangeMember, PortPlaybookSection — sengaja TIDAK
// membawa tenantId dan TIDAK didaftarkan; aksesnya wajib lewat induk (K44/K89).
//
// entityType/entityId pada Attachment, Comment, dan EmailLog bersifat POLIMORFIK
// (K84): tidak ada FK, jadi database TIDAK menjamin entityId menunjuk baris yang
// ada — apalagi baris milik tenant yang sama. Karena itu setiap penulisan wajib
// lewat pastikanEntitasMilikTenant() (K85, services/ops/ownership.service.ts).
// ============================================================================

// ------------------------------------------------------------ TASK & CHECKLIST

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// K90 — Task menempel pada Voyage, dengan penunjuk opsional ke entitas yang
/// lebih spesifik. Keempat penunjuk itu FK sungguhan (bukan polimorfik):
/// jumlahnya tetap dan sudah diketahui semuanya, jadi K84 tidak berlaku.
model Task {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// K83 — nullable HANYA untuk tugas kantor yang bukan milik kunjungan mana pun (P45).
  voyageId String?
  voyage   Voyage? @relation(fields: [voyageId], references: [id])

  portCallId     String?
  portCall       PortCall?     @relation(fields: [portCallId], references: [id])
  disbursementId String?
  disbursement   Disbursement? @relation(fields: [disbursementId], references: [id])
  vendorId       String?
  vendor         Vendor?       @relation(fields: [vendorId], references: [id])

  title       String
  description String?
  category    String? // PORT_CLEARANCE | HUSBANDRY | CREW | FINANCE | DOCUMENT | VENDOR | OTHER
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NORMAL)

  /// String polos TANPA relasi — sama seperti AuditLog.userId. Pengguna
  /// dinonaktifkan (isActive=false), tidak dihapus keras, dan tugas lama harus
  /// tetap terbaca meski penanggung jawabnya sudah keluar.
  assigneeUserId  String?
  createdByUserId String

  /// K92 — urutan dalam kolom Kanban. Float supaya sisipan di tengah menyentuh
  /// SATU baris, bukan menomori ulang seluruh kolom.
  boardOrder Float @default(0)

  // --- penjadwalan (K94-K96) ---
  anchor      String? // ETA | ETB | ETC | ETD | ATA | VOYAGE_CREATED | MANUAL
  offsetHours Int? // negatif = SEBELUM jangkar. -24 = "24 jam sebelum ETA"
  dueAt       DateTime?
  dueAtManual Boolean   @default(false) // true = jangkar berhenti menggerakkannya
  slaHours    Int? // target penyelesaian (K100)

  startedAt     DateTime?
  completedAt   DateTime? // K99 — snapshot, bukan turunan updatedAt
  blockedReason String?

  /// K95 — idempotensi instansiasi checklist. NULL untuk tugas yang dibuat tangan;
  /// Postgres memperlakukan tiap NULL sebagai berbeda, jadi tugas buatan tangan
  /// tidak saling bertabrakan pada @@unique di bawah.
  sourceTemplateItemId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([voyageId, sourceTemplateItemId])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, voyageId, status, boardOrder])
  @@index([tenantId, assigneeUserId, status])
}

/// K93 — auto-checklist per pelabuhan/jenis keagenan, dengan jangkar waktu
/// RELATIF (bukan tanggal absolut: ETA kapal selalu berubah).
model TaskTemplate {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  portId     String? // null = berlaku untuk semua pelabuhan
  port       Port?     @relation(fields: [portId], references: [id])
  agencyType String? // FULL | PROTECTIVE | HUSBANDRY — cocok dengan Voyage.agencyType
  vesselType String?
  isDefault  Boolean   @default(false)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  items TaskTemplateItem[]

  @@index([tenantId, portId])
}

/// Model ANAK — tanpa tenantId, akses wajib lewat induk (K44).
model TaskTemplateItem {
  id           String       @id @default(cuid())
  templateId   String
  template     TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  category     String?
  anchor       String       @default("ETA") // ETA | ETB | ETC | ETD | VOYAGE_CREATED
  offsetHours  Int          @default(0) // negatif = sebelum jangkar
  slaHours     Int?
  defaultRole  String? // USUL penugasan, bukan pagar (K98)
  priority     TaskPriority @default(NORMAL)
  displayOrder Int          @default(0)

  @@index([templateId])
}

// ------------------------------------------------------ ATTACHMENT & COMMENT

/// K106 — satu tabel lampiran untuk SEMUA entitas. Nilainya justru pada layar
/// "semua lampiran voyage ini": satu query, bukan sepuluh.
model Attachment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// K84/K85 — daftar putih di services/ops/owner-guard.ts. TIDAK ADA FK;
  /// kepemilikan diperiksa kode sebelum setiap penulisan.
  entityType String
  entityId   String

  fileName   String // nama asli, sudah dinormalkan (K109)
  mimeType   String
  sizeBytes  Int
  sha256     String // integritas + deteksi unggahan ganda
  storageKey String // kunci di adapter penyimpanan (K107) — BUKAN path yang bisa ditebak

  kind      String? // RECEIPT | RATE_SHEET | CREW_DOC | VENDOR_DOC | CONTRACT | GENERAL
  note      String?
  sensitive Boolean   @default(false) // K126 — dokumen pribadi awak, dll
  expiresAt DateTime? // K115 — sertifikat/izin vendor yang kedaluwarsa

  uploadedByUserId String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime? // K110 — soft delete; berkas fisik TIDAK pernah dihapus

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, sha256])
  @@index([tenantId, expiresAt])
}

/// K128 — catatan pada entitas. Datar (tanpa thread), bukan messenger.
model Comment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// K84/K85 — daftar putih owner-guard.ts.
  entityType String
  entityId   String

  body             String
  authorUserId     String
  authorName       String? // disalin, pola Approval.userName — penulis bisa nonaktif nanti
  mentionedUserIds String[] @default([])

  editedAt  DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft delete: baris tetap tampil sebagai "komentar dihapus"

  @@index([tenantId, entityType, entityId, createdAt])
}

// ------------------------------------------------------------------- VENDOR

/// K115 — penilaian manusia atas satu pekerjaan vendor. Append-only, seperti
/// Approval: penilaian yang bisa diedit sesudah faktanya bukan penilaian,
/// melainkan opini terkini. Karena itu TIDAK ada updatedAt/deletedAt.
model VendorRating {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor  @relation(fields: [vendorId], references: [id])
  workOrderId String? // konteks penilaian, bila ada
  voyageId    String?

  score         Int // 1..5, divalidasi service
  note          String?
  ratedByUserId String
  ratedByName   String? // disalin, pola Approval.userName

  createdAt DateTime @default(now())

  @@index([tenantId, vendorId, createdAt])
}

// --------------------------------------------------- PURCHASE & WORK ORDER

/// K3 diteruskan: satu tabel untuk PR & PO, karena bentuk & alurnya identik
/// dan yang berbeda hanya siapa penerimanya + tahap dalam proses pengadaan.
enum PurchaseKind {
  PR // permintaan internal
  PO // pesanan ke vendor
}

enum PurchaseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// K117 — entitas v2. Jalur MaritimeDocument lama TIDAK disentuh & tidak
/// dimatikan; PDF-nya memakai ulang ProcurementDocument yang sudah ada (K119).
model PurchaseOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  voyageId String? // K83: pengadaan kantor boleh tanpa voyage
  voyage   Voyage? @relation(fields: [voyageId], references: [id])
  vendorId String? // wajib untuk kind = PO, opsional untuk PR (belum tahu vendornya)
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  sourceRequisitionId String? // PO yang lahir dari PR

  kind      PurchaseKind
  docNumber String // PO/2026/08/0001 — formatDocNumber yang sudah ada (K32)
  status    PurchaseStatus @default(DRAFT)

  currency     String @default("IDR")
  exchangeRate Float  @default(1) // snapshot (K5/K29)
  subtotal     Float  @default(0)
  taxPct       Float?
  taxAmount    Float  @default(0)
  grandTotal   Float  @default(0)

  deliveryTo      String?
  neededBy        DateTime?
  terms           String?
  notes           String?
  issuedAt        DateTime  @default(now())
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  items PurchaseOrderItem[]

  @@unique([tenantId, docNumber])
  @@index([tenantId, status])
  @@index([tenantId, voyageId, kind])
  @@index([tenantId, vendorId])
}

/// Model ANAK (tanpa tenantId) — akses wajib lewat induk (K44).
model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  description  String
  quantity     Float   @default(1)
  unit         String?
  unitPrice    Float   @default(0)
  amount       Float   @default(0)
  receivedQty  Float   @default(0) // untuk PARTIALLY_RECEIVED
  displayOrder Int     @default(0)

  @@index([purchaseOrderId])
}

enum WorkOrderStatus {
  DRAFT
  ISSUED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CANCELLED
}

/// K121 — SPK ke vendor untuk satu pekerjaan. Terpisah dari PO, dan bukan Task:
/// Task menjawab "siapa di tim kita", WorkOrder menjawab "vendor apa yang kita
/// perintahkan, dengan harga berapa".
model WorkOrder {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voyageId  String // K83 — WAJIB, tak ada work order tanpa kunjungan
  voyage    Voyage          @relation(fields: [voyageId], references: [id])
  vendorId  String
  vendor    Vendor          @relation(fields: [vendorId], references: [id])
  serviceId String? // jasa dari katalog, bila cocok
  service   ServiceCatalog? @relation(fields: [serviceId], references: [id])

  woNumber String
  scope    String // uraian pekerjaan
  status   WorkOrderStatus @default(DRAFT)

  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime? // K114 — bahan metrik ketepatan waktu

  agreedAmount    Float?
  currency        String    @default("IDR")
  notes           String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([tenantId, woNumber])
  @@index([tenantId, voyageId, status])
  @@index([tenantId, vendorId, actualEnd])
}

// -------------------------------------------------------------- CREW CHANGE

enum CrewChangeStatus {
  PLANNED
  DOCUMENTS_READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// K125 — satu-satunya husbandry yang butuh tabel sendiri, karena ia membawa
/// data yang bukan milik Tribuana (identitas orang) dan jadwal yang bukan
/// jadwal kapal (penerbangan).
model CrewChange {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voyageId String // K83 — wajib
  voyage   Voyage  @relation(fields: [voyageId], references: [id])
  portId   String?
  port     Port?   @relation(fields: [portId], references: [id])

  plannedDate     DateTime?
  status          CrewChangeStatus @default(PLANNED)
  agentNote       String?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  members CrewChangeMember[]

  @@index([tenantId, voyageId])
  @@index([tenantId, plannedDate])
}

/// Model ANAK (tanpa tenantId) — akses wajib lewat induk (K44).
///
/// ⚠️ K126 — field di bawah adalah DAFTAR PUTIH yang dipilih sadar: cukup untuk
/// mengisi CREW_CHANGE_NOTICE / CREW_SIGN_ON/OFF / SHORE_PASS / CREW_LIST yang
/// sudah ada, dan tidak lebih. Yang SENGAJA tidak disimpan meski lazim di
/// formulir: tanggal lahir, alamat rumah, kontak keluarga, data medis, nomor
/// rekening awak. Setiap kolom yang ada akan terisi lalu harus dijaga selamanya.
/// `documentNo` tidak pernah ikut di respons API daftar (K126/1).
model CrewChangeMember {
  id           String     @id @default(cuid())
  crewChangeId String
  crewChange   CrewChange @relation(fields: [crewChangeId], references: [id], onDelete: Cascade)

  movement    String // SIGN_ON | SIGN_OFF
  fullName    String
  rank        String? // Master, C/O, 2/E, AB, ...
  nationality String?
  documentNo  String? // paspor / buku pelaut — LIHAT K126
  flightNo    String?
  flightAt    DateTime?
  hotel       String?
  visaStatus  String?
  remarks     String?

  displayOrder Int @default(0)

  @@index([crewChangeId])
}

// ----------------------------------------------------------- VOYAGE EVENT

/// K130 — fakta bertanda waktu; sumber data SOF yang selama ini diketik ulang
/// sebagai teks bebas di dalam JSON dokumen.
model VoyageEvent {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voyageId   String
  voyage     Voyage    @relation(fields: [voyageId], references: [id])
  portCallId String?
  portCall   PortCall? @relation(fields: [portCallId], references: [id])

  /// Daftar kode tetap + OTHER, BUKAN enum Prisma — alasan yang sama dengan K55
  /// (dataOrigin): daftar peristiwa pelabuhan akan bertambah dari pengalaman,
  /// dan setiap penambahan tidak boleh butuh migration.
  eventCode   String // EOSP | NOR_TENDERED | PILOT_ON_BOARD | ALL_FAST | COMMENCED | ...
  description String?
  occurredAt  DateTime
  source      String   @default("MANUAL") // MANUAL | IMPORT | SYSTEM
  remarks     String?

  recordedByUserId String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  @@index([tenantId, voyageId, occurredAt])
}

// -------------------------------------------------------------- EMAIL LOG

/// K136 — mencatat yang DIAKUI MANUSIA, bukan hasil pengiriman. Tidak ada
/// mailer di repo ini (P10 masih terbuka): status SENT_MANUAL berarti "operator
/// menyatakan sudah mengirimnya", persis semantik Disbursement.status = SENT.
model EmailLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// K84/K85 — daftar putih owner-guard.ts.
  entityType String // VOYAGE | DISBURSEMENT | INVOICE | PURCHASE_ORDER | WORK_ORDER
  entityId   String

  template      String? // EPDA_PENGANTAR | FDA_PENYELESAIAN | INVOICE_TAGIHAN | VENDOR_PENAWARAN (K79)
  toAddress     String?
  ccAddress     String?
  subject       String
  bodySnapshot  String? // isi saat itu — K138 (semangat snapshot K5)
  attachmentIds String[] @default([])

  status String    @default("DRAFTED") // DRAFTED | SENT_MANUAL | NO_RESPONSE | REPLIED
  sentAt DateTime? // diisi operator, BUKAN oleh sistem

  recordedByUserId String
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  @@index([tenantId, entityType, entityId, createdAt])
}

// ------------------------------------------------- PLAYBOOK & KNOWLEDGE BASE

enum PlaybookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// K139 — berversi, dengan pola yang sudah dipakai Disbursement (K37):
/// menerbitkan versi baru = baris baru, versi lama jadi ARCHIVED dan TIDAK
/// pernah disentuh isinya. Port.notes tidak dihapus & tidak dimigrasikan paksa.
model PortPlaybook {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portId   String
  port     Port   @relation(fields: [portId], references: [id])

  version     Int            @default(1)
  title       String
  status      PlaybookStatus @default(DRAFT)
  publishedAt DateTime?
  summary     String?

  authorUserId String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sections PortPlaybookSection[]

  @@unique([tenantId, portId, version])
  @@index([tenantId, portId, status])
}

/// Model ANAK (tanpa tenantId) — akses wajib lewat induk (K44).
model PortPlaybookSection {
  id         String       @id @default(cuid())
  playbookId String
  playbook   PortPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  heading      String
  body         String // teks panjang; Markdown ringan, dirender TANPA HTML mentah
  displayOrder Int    @default(0)

  @@index([playbookId])
}

/// K140 — pengetahuan yang TIDAK terikat pelabuhan. Sengaja tanpa versi (beda
/// dari playbook): artikel umum tidak dipakai sebagai dasar tindakan pada satu
/// kunjungan tertentu, jadi tak ada yang perlu dibuktikan "apa yang tertulis
/// saat itu". Perbedaan ini keputusan, bukan kelalaian.
model KnowledgeArticle {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title  String
  body   String
  tags   String[]       @default([])
  status PlaybookStatus @default(DRAFT)

  authorUserId String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId, status])
}
