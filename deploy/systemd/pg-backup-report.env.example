# Pasang: /etc/tribuana/pg-backup-report.env  (root:root 0644 — TIDAK memuat rahasia)
#
# ⚠️ WAJIB dicocokkan dengan /usr/local/sbin/pg-backup.sh SEBELUM dipasang.
#    Direktori, pola nama, dan format artefak maritime_suite BELUM terverifikasi
#    dari repo (skrip backup hanya ada di VM). Nilai di bawah adalah contoh.

BACKUP_DIR=/var/backups/postgresql/daily
BACKUP_GLOB=maritime_suite*
MAX_AGE_HOURS=26
MIN_BYTES=1024
# Kosongkan untuk mematikan peringatan retensi. Isi = jumlah hari retensi pg-backup.sh.
RETENTION_DAYS=
JOB_BASE_URL=http://127.0.0.1:3001
