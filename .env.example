# ============================================================
#  Maritime Suite — contoh environment untuk PRODUKSI
#  Salin ke .env di server, isi nilai sebenarnya. JANGAN commit .env asli.
# ============================================================

# --- Database (PostgreSQL) ---
# URL koneksi utama. Untuk Postgres terkelola (Neon/Supabase) gunakan URL "pooled".
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/maritime_suite?schema=public"
# URL langsung (non-pooled) untuk migrasi/db push. Sama dgn DATABASE_URL bila VPS/Postgres biasa.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/maritime_suite?schema=public"

# --- Autentikasi (NextAuth) ---
# WAJIB kuat & rahasia. Buat dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-secret-acak-yang-kuat"
# Domain produksi Anda (harus persis, dengan https).
NEXTAUTH_URL="https://app.domainanda.com"

# --- Branding publik (opsional) ---
NEXT_PUBLIC_APP_NAME="Maritime Suite"
NEXT_PUBLIC_APP_URL="https://app.domainanda.com"

# --- Asisten AI (OpenRouter) — wajib bila fitur AI dipakai ---
# Ambil di https://openrouter.ai/keys . Ada biaya per pemakaian.
OPENROUTER_API_KEY="sk-or-xxxxxxxxxxxxxxxx"
# Opsional: override model bila katalog OpenRouter berubah.
# Default kode kini Sonnet 4.5 (akurasi lebih tinggi). Untuk Sonnet 5:
# OPENROUTER_SPK_MODEL="anthropic/claude-sonnet-5"

# --- Pembayaran (Midtrans) — wajib bila billing dipakai ---
# Ambil di dashboard Midtrans → Settings → Access Keys.
# Sandbox: https://dashboard.sandbox.midtrans.com  |  Production: https://dashboard.midtrans.com
# PENTING: key Sandbox modern TIDAK berawalan "SB-". Bedakan mode lewat flag di bawah.
MIDTRANS_IS_PRODUCTION="true"
MIDTRANS_SERVER_KEY="Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxxxxxx"

# --- Pekerjaan berjadwal (job runner) — wajib bila pengingat/SLA dipakai ---
# Token rahasia BERSAMA untuk POST /api/jobs/run?job=reminders (K88).
# BUKAN kredensial pengguna: tak ada akun, peran, atau sesi di baliknya. Ia hanya
# membuktikan bahwa pemanggilnya penjadwal Anda sendiri (cron Vercel/Railway,
# systemd timer, Task Scheduler Windows) — penjadwal tidak punya browser dan
# tidak akan pernah bisa login.
# Buat dengan: openssl rand -hex 32
# Minimal 16 karakter; bila kosong/lebih pendek, endpoint menolak SEMUA
# permintaan (tertutup secara bawaan). Contoh pemakaian:
#   curl -X POST -H "x-job-token: $JOB_RUNNER_TOKEN" \
#        "https://app.domainanda.com/api/jobs/run?job=reminders"
JOB_RUNNER_TOKEN="ganti-dengan-token-acak-panjang"

# Alamat INTERNAL app untuk panggilan job dari server sendiri (PRD-002 Step 3):
# tombol "Jalankan pengingat sekarang" di Settings. Di VM produksi:
# http://127.0.0.1:3001 (loopback, tidak lewat nginx). Bila kosong, tombol
# memakai NEXT_PUBLIC_APP_URL seperti sebelumnya.
JOB_RUNNER_BASE_URL="http://127.0.0.1:3001"

# --- Automation Hub (PRD-002 Step 5B) — PRIVAT untuk tenant yang diizinkan ---
# Bawaan MATI. Aktif hanya bila flag persis "true" DAN daftar id tenant terisi.
# Isi dengan id tenant (cuid), BUKAN nama perusahaan; pisahkan dengan koma.
# Satu entri tidak sah → seluruh Automation Hub mati (gagal tertutup).
AUTOMATION_MONITORING_ENABLED="false"
AUTOMATION_TENANT_IDS=""

# --- Posisi AIS (PRD-003 Step 4) — bagian Automation Hub, bawaan MATI ---
# AIS_TENANT_IDS WAJIB subset AUTOMATION_TENANT_IDS; satu nilai tak sah → AIS mati.
# AIS_PROVIDER: id dari daftar tetap (NONE | FAKE). FAKE hanya dev/uji, ditolak di
# produksi. Belum ada adapter vendor sungguhan.
# AIS_MONTHLY_CALL_CAP (D5): WAJIB bilangan bulat > 0. Kosong = TIDAK ADA panggilan
# penyedia sama sekali (gagal tertutup).
# AIS_STALE_HOURS (D7): ambang sinyal AIS_STALE, bawaan 6 jam (1–168).
# AIS_POLL_INTERVAL_MIN: bawaan 60 (15–1440).
# AIS_PROVIDER_API_KEY: hanya untuk adapter vendor kelak (≥ 16 karakter). Jangan commit.
AIS_ENABLED="false"
AIS_TENANT_IDS=""
AIS_PROVIDER="NONE"
AIS_MONTHLY_CALL_CAP=""
AIS_STALE_HOURS="6"
AIS_POLL_INTERVAL_MIN="60"
AIS_PROVIDER_API_KEY=""

# PRD-004 Step 3 — Vessel Call Intake (Automation Hub). BAWAAN MATI. Aktif hanya bila
# "true" PERSIS, DAN gerbang Automation Hub di atas lolos (allowlist tenant +
# ADMIN/MANAJER_OPERASI). Input manual saja (D1). Voyage hanya dibuat sesudah approval.
# VESSEL_CALL_INTAKE_EXTRACTOR: OPENROUTER (bawaan, butuh OPENROUTER_API_KEY) | FAKE
# (dev/uji tanpa jaringan — ditolak di produksi; nilai lain → fitur mati).
VESSEL_CALL_INTAKE_ENABLED="false"
VESSEL_CALL_INTAKE_EXTRACTOR="OPENROUTER"

# --- Super-admin (operator SaaS) ---
# Email (dipisah koma) yang boleh membuka /admin & mengaktifkan langganan tenant
# secara manual setelah verifikasi bukti transfer bank.
SUPERADMIN_EMAILS="operator@perusahaan.com"

# --- Portal pihak luar (Fase 8a, K147/K149) ---
# Peran database KEDUA (`maritime_portal`), dibuat migrasi prisma/migrations/
# 20260818163500_fase8a_portal_rls — SAMA database dengan DATABASE_URL,
# kredensial BERBEDA. WAJIB kredensial produksi sendiri (bukan salinan dev) —
# lihat catatan rotasi di migration.sql itu sendiri.
PORTAL_DATABASE_URL="postgresql://maritime_portal:GANTI_SANDI_INI@HOST:5432/maritime_suite?schema=public"
# Secret TERPISAH dari NEXTAUTH_SECRET (K144) — sesi portal & sesi internal
# tak boleh saling terbaca meski cookie-nya kebetulan tertukar.
# Buat dengan: openssl rand -base64 32
PORTAL_NEXTAUTH_SECRET="ganti-dengan-secret-acak-yang-berbeda-dari-NEXTAUTH_SECRET"
